/*
 * Правая половина Keyball61 БЕЗ донгла: она сама подключается к компьютеру
 * (по USB или Bluetooth) и является главным устройством (central).
 * Левая половина подключается к правой. Для левой используется обычная
 * сборка keyball61_left.
 *   NCS  -> Pro Micro D10  (P0.09)
 *   MOSI -> Pro Micro D16  (P0.10)
 *   MISO -> Pro Micro D14  (P1.11)
 *   SCLK -> Pro Micro D15  (P1.13)
 */

#include "keyball61.dtsi"
#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <input/processors.dtsi>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* Ключи правой половины идут в карте после ключей левой */
&default_transform {
    col-offset = <9>;
};

/* Усиленная мощность выводов SPI: помогает, если между линиями есть утечка.
 * Пины как на плате: SCLK = P1.13, MOSI = P0.10, MISO = P1.11. */
&pinctrl {
    kb_spi_default: kb_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
        group2 {
            psels = <NRF_PSEL(SPIM_MISO, 1, 11)>;
        };
    };

    kb_spi_sleep: kb_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                    <NRF_PSEL(SPIM_MISO, 1, 11)>;
            low-power-enable;
        };
    };
};

&pro_micro_spi {
    status = "okay";
    pinctrl-0 = <&kb_spi_default>;
    pinctrl-1 = <&kb_spi_sleep>;
    pinctrl-names = "default", "sleep";
    /* NCS = D10 = P0.09. Флаги мощности вывода нельзя передавать через &pro_micro,
     * поэтому указан контроллер gpio0 напрямую. */
    cs-gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | NRF_GPIO_DRIVE_H0H1)>;

    trackball: trackball@0 {
        compatible = "pixart,pmw3360";
        reg = <0>;
        spi-max-frequency = <2000000>;
        cpi = <500>;
    };
};

/ {
    input_processors {
        /* Масштабирование прокрутки с накоплением остатка (плавный скролл) */
        kb_scroll_scaler: kb_scroll_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };

        /* Масштабирование курсора с накоплением остатка */
        kb_xy_scaler: kb_xy_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
        };
    };

    /* Слои-флаги скорости прокрутки + слой 3 (режим прокрутки) = слои 8 и 9 */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        scroll_slow_active {
            if-layers = <3 6>;
            then-layer = <8>;
        };

        scroll_fast_active {
            if-layers = <3 7>;
            then-layer = <9>;
        };
    };

    /*
     * Правила проверяются сверху вниз, срабатывает первое подошедшее.
     * Слои: 3 = прокрутка (удерживается), 4/5 = курсор медленнее/быстрее,
     *       6/7 = прокрутка медленнее/быстрее, 8/9 = служебные.
     * Оси датчика повёрнуты на 90 градусов: в каждом правиле сначала меняем X и Y местами.
     * Обычный курсор (ни одно правило не подошло): только обмен осей.
     */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>;

        scroll_slow {
            layers = <8>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                                &zip_xy_to_scroll_mapper
                                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                                &kb_scroll_scaler 1 8>;
        };

        scroll_fast {
            layers = <9>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                                &zip_xy_to_scroll_mapper
                                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                                &kb_scroll_scaler 1 2>;
        };

        scroller {
            layers = <3>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                                &zip_xy_to_scroll_mapper
                                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                                &kb_scroll_scaler 1 4>;
        };

        cursor_slow {
            layers = <4>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                                &kb_xy_scaler 1 2>;
        };

        cursor_fast {
            layers = <5>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                                &kb_xy_scaler 2 1>;
        };
    };
};

/*
 * ZMK Studio: вместо отдельных kscan и matrix-transform используется физическая
 * раскладка, которая на них ссылается. Размеры и координаты клавиш в сотых долях
 * клавиши (100 = 1 клавиша), порядок клавиш = порядок в keymap.
 */
/ {
    chosen {
        /delete-property/ zmk,matrix-transform;
        /delete-property/ zmk,kscan;
        zmk,physical-layout = &keyball61_physical_layout;
    };

    keyball61_physical_layout: keyball61_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Keyball61";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys
        = <&key_physical_attrs 100 100 99 25 1060 149 75>
        , <&key_physical_attrs 100 100 196 49 1060 246 99>
        , <&key_physical_attrs 100 100 300 36 1060 350 86>
        , <&key_physical_attrs 100 100 402 35 1060 452 85>
        , <&key_physical_attrs 100 100 496 78 1060 546 128>
        , <&key_physical_attrs 100 100 590 117 1060 640 167>
        , <&key_physical_attrs 100 100 953 117 (-1060) 1003 167>
        , <&key_physical_attrs 100 100 1048 78 (-1060) 1098 128>
        , <&key_physical_attrs 100 100 1141 35 (-1060) 1191 85>
        , <&key_physical_attrs 100 100 1243 36 (-1060) 1293 86>
        , <&key_physical_attrs 100 100 1347 49 (-1060) 1397 99>
        , <&key_physical_attrs 100 100 1445 25 (-1060) 1495 75>
